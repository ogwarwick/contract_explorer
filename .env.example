# ==============================================================================
# ContractExplorer Environment Configuration
# Copy this file to .env and provide your actual API keys and database URL.
# NEVER commit your real .env file or credentials to source control.
# ==============================================================================

# Isaacus API Key (used for Kanon 2 embeddings and legal enrichment)
ISAACUS_API_KEY=your_isaacus_api_key_here

# OpenAI API Key (used for RAG clause Q&A service)
OPENAI_API_KEY=your_openai_api_key_here
# Note: OPEN_AI_KEY is also accepted as an alternative fallback
# OPEN_AI_KEY=your_openai_api_key_here

# PostgreSQL Database Connection URL
# Local default:
DATABASE_URL=postgresql://postgres:password@localhost:5432/lcha
# Production example:
# DATABASE_URL=postgresql://postgres:<password>@<host>:<port>/<dbname>
